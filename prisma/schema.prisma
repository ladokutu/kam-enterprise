generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ ADMIN ============

model AdminUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ HERO ============

model Hero {
  id          Int    @id @default(autoincrement())
  headline    String
  subheadline String @default("")
  ctaText     String @default("Hubungi Kami")
  ctaLink     String @default("/contact")
  imageUrl    String @default("")
}

// ============ SERVICES ============

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  icon        String   @default("")
  imageUrl    String   @default("")
  features    String   @default("[]") // JSON array as string
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ PORTFOLIO ============

model Portfolio {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  category    String
  imageUrl    String   @default("")
  techStack   String   @default("[]") // JSON array as string
  link        String   @default("")
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ ABOUT ============

model About {
  id          Int      @id @default(autoincrement())
  companyName String
  brandName   String   @default("")
  logoUrl     String   @default("")
  vision      String   @db.Text
  mission     String   @db.Text
  description String   @db.Text
  imageUrl    String   @default("")
  address     String   @default("")
  latitude    String   @default("")
  longitude   String   @default("")
  phone       String   @default("")
  email       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ TEAM ============

model TeamMember {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  bio       String   @db.Text
  imageUrl  String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ TESTIMONIALS ============

model Testimonial {
  id         Int      @id @default(autoincrement())
  clientName String
  company    String   @default("")
  message    String   @db.Text
  rating     Int      @default(5)
  imageUrl   String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ CONTACTS (Pesan Masuk) ============

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String   @default("")
  service   String   @default("")
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ SETTINGS ============

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}